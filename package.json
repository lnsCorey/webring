{
  "name": "webring-studio",
  "version": "1.0.0",
  "description": "Self-contained federated personal profile & webring studio with static JSON generation and ATProto did:web identity",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "mcp": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 electron dist-electron/electron/mcp/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2-sftp-client": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
